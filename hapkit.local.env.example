# Copy to hapkit.local.env (gitignored) and adjust. Environment variables of the same name take precedence.
# KEY=VALUE per line, no quotes.

# ro.serialno of the test device (userdebug, rooted debugging, verity disabled); other serials are rejected
HAPKIT_SERIAL=
# serials always rejected, comma separated
HAPKIT_FORBID=
# adb binary; default: adb, then adb.exe on PATH. Windows adb.exe works from WSL (host paths converted with wslpath).
#HAPKIT_ADB=/path/to/platform-tools/adb

# tools/devinstall.sh only:
# kernel source containing the haptic_hv primitives series
#HAPKIT_KDIR=/path/to/kernel/fairphone/sm7635
# command running make for the device kernel's prepared build tree; invoked as "$HAPKIT_KMAKE M=<dir> modules"
#HAPKIT_KMAKE=/path/to/kmake.sh
# llvm-strip (default: on PATH)
#HAPKIT_STRIP=/path/to/llvm-strip
